    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List available products in the ButuhSayur catalog (name, price, unit, category, stock).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category filter, e.g. 'bumbu', 'sayur'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch full details for a single product by its ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Product UUID or string ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_product",
        "title": "Create product",
        "description": "Create a new product in the ButuhSayur catalog. Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Product name, e.g. 'Bayam Merah'."
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Price in IDR."
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "default": "pack",
              "description": "Unit, e.g. 'pack', 'kg', 'ikat'."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Category, e.g. 'vegetables', 'bumbu', 'fruit'."
            },
            "description": {
              "type": "string",
              "description": "Product description."
            },
            "stock": {
              "type": "integer",
              "minimum": 0,
              "default": 100,
              "description": "Initial stock quantity."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Primary image URL."
            },
            "is_featured": {
              "type": "boolean",
              "default": false,
              "description": "Whether to feature this product."
            },
            "is_flash_sale": {
              "type": "boolean",
              "default": false,
              "description": "Whether this is a flash sale product."
            },
            "flash_sale_price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Flash sale price in IDR."
            },
            "flash_sale_ends_at": {
              "type": "string",
              "description": "Flash sale end time (ISO 8601)."
            },
            "health_benefits": {
              "type": "string",
              "description": "Health benefits text."
            }
          },
          "required": [
            "name",
            "price",
            "category"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_product",
        "title": "Update product",
        "description": "Update an existing product in the ButuhSayur catalog. Admin only.",
        "annotations": {
          "readOnlyHint": false,
