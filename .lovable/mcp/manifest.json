          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Product ID to update."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "New product name."
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "New price in IDR."
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "description": "New unit."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "New category."
            },
            "description": {
              "type": "string",
              "description": "New description."
            },
            "stock": {
              "type": "integer",
              "minimum": 0,
              "description": "New stock quantity."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "New primary image URL."
            },
            "is_featured": {
              "type": "boolean",
              "description": "Whether to feature this product."
            },
            "is_flash_sale": {
              "type": "boolean",
              "description": "Whether this is a flash sale product."
            },
            "flash_sale_price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Flash sale price in IDR."
            },
            "flash_sale_ends_at": {
              "type": "string",
              "description": "Flash sale end time (ISO 8601)."
            },
            "in_stock": {
              "type": "boolean",
              "description": "Whether the product is in stock."
            },
            "health_benefits": {
              "type": "string",
              "description": "Health benefits text."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_product",
        "title": "Delete product",
        "description": "Delete a product from the ButuhSayur catalog. Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
